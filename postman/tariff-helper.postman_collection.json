{
  "info": {
    "name": "Tariff Helper",
    "description": "Pilot API tests. Set baseUrl to your server (default http://localhost:8080). Locally, start the app with RATE_LIMIT_PER_MINUTE=100 before running the whole collection, otherwise the rate limit (5 estimates a minute) returns 429. With LLM_PROVIDER=claude each estimate costs a small amount of API credit.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "1. Basics",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.test(\"status is UP\", function () { pm.expect(j.status === 'UP').to.be.true; });"
                ]
              }
            }
          ]
        },
        {
          "name": "List agreements",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/agreements",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "agreements"
              ]
            },
            "description": "Agreements, their status and the job categories for the form."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.test(\"KS available\", function () { pm.expect(j.some(a => a.id === 'ks-hta' && a.status === 'available')).to.be.true; });",
                  "pm.test(\"Oslo available\", function () { pm.expect(j.some(a => a.id === 'oslo-kommune' && a.status === 'available')).to.be.true; });",
                  "pm.test(\"State has a reason\", function () { pm.expect(j.some(a => a.id === 'staten' && a.unavailableReason)).to.be.true; });",
                  "pm.test(\"No pay tables exposed\", function () { pm.expect(!JSON.stringify(j).includes('salaryLadders')).to.be.true; });"
                ]
              }
            }
          ]
        }
      ]
    },
