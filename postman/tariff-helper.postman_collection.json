              "raw": "{\n  \"agreementId\": \"ks-hta\",\n  \"jobCategory\": \"nurse\",\n  \"positionPercent\": 100,\n  \"currentAnnualSalary\": 500000,\n  \"experiences\": [\n    {\n      \"country\": \"NO\",\n      \"kind\": \"private_service\",\n      \"startDate\": \"2018-03\",\n      \"endDate\": \"2020-06\",\n      \"relevance\": \"related\",\n      \"workType\": \"hospital_ward\"\n    }\n  ]\n}",
